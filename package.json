{
  "name": "ironlog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IRONLOG — workout tracker with Google Sign-In and a synced backend.",
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "cross-env NODE_ENV=development node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "test": "node --test",
    "deploy": "fly deploy --depot=false"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.0",
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "supertest": "^7.2.2",
    "vite": "^6.0.7"
  }
}
